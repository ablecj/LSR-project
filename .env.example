# LRS Legal & Relocation Services — Contact Form Delivery Configuration
# Copy this file to .env.local and configure either Option A (Webhook) or Option B (Resend Email API)

# Option A: Webhook / CRM endpoint
# CONTACT_WEBHOOK_URL=https://your-crm-or-webhook-endpoint.example.com

# Option B: Resend Email API
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# CONTACT_RECEIVER_EMAIL=info@lrs-global.com
# CONTACT_SENDER_EMAIL="LRS Advisory Desk <advisory@yourdomain.com>"
